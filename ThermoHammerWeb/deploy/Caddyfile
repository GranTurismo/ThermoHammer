# Serves the generated site inside the `thweb` container. TLS and the public host name belong to the outer proxy.
{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), browsing-topics=()"
		-Server
	}
	# /embed/ pages exist to be shown inside other sites (reviewers' articles); nothing else may be framed
	@framed not path /embed/*
	header @framed {
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}
	@embed path /embed/*
	header @embed Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors *"

	# /models/: the LLM test's Neural Engine model for iPhones and Macs (CpuThrottlingTest/Benchmark/LLM/LlmNpuModel.swift),
	# ~1 GB, checked by its SHA-256 in the app. A new build gets a new name, so a file never changes. Served as is: it's
	# already compressed, and a download that stopped can resume (ranges).
	handle_path /models/* {
		root * /models
		header Cache-Control "public, max-age=31536000, immutable"
		header Content-Type "application/octet-stream"
		file_server
	}

	# everything under /assets/ has a content hash in its name, so it never changes
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@og path /og/*
	header @og Cache-Control "public, max-age=604800"
	@pages not path /assets/* /og/*
	header @pages Cache-Control "public, max-age=300, stale-while-revalidate=86400"

	handle_errors {
		@missing expression {err.status_code} == 404
		rewrite @missing /404.html
		file_server
	}

	file_server
}
