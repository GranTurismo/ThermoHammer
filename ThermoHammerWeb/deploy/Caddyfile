# Serves the generated site inside the `thweb` container. TLS and the public host name belong to the outer proxy.
{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), browsing-topics=()"
		-Server
	}
	# /embed/ pages exist to be shown inside other sites (reviewers' articles); nothing else may be framed
	@framed not path /embed/*
	header @framed {
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}
	@embed path /embed/*
	header @embed Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors *"

	# /models/: the LLM test's NPU models, checked by their SHA-256 in the apps. Served as is: they're already
	# compressed, and a download that stopped can resume (ranges).
	#   /models/<name>.aar  the Neural Engine model for iPhones and Macs (LlmNpuModel.swift), ~1 GB: a new build gets a
	#                       new name, so a file never changes
	#   /models/android/    Android chips' Gemma files and manifest.json (NpuServerModels.kt, tools/npu_models): the
	#                       list changes and a chip's file can be rebuilt under its name, so always revalidated
	handle_path /models/* {
		root * /models
		# (a header line without a matcher would run last and override the matched ones)
		@android path /android/*
		@fixed not path /android/*
		@blob not path /android/manifest.json
		@manifest path /android/manifest.json
		header @fixed Cache-Control "public, max-age=31536000, immutable"
		header @android Cache-Control "no-cache"
		header @blob Content-Type "application/octet-stream"
		header @manifest Content-Type "application/json"
		file_server {
			hide .*
		}
	}

	# everything under /assets/ has a content hash in its name, so it never changes
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@og path /og/*
	header @og Cache-Control "public, max-age=604800"
	@pages not path /assets/* /og/*
	header @pages Cache-Control "public, max-age=300, stale-while-revalidate=86400"

	handle_errors {
		@missing expression {err.status_code} == 404
		rewrite @missing /404.html
		file_server
	}

	file_server
}
