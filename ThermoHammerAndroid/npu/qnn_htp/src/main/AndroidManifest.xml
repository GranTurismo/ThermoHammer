        <dist:delivery>
            <dist:install-time>
                <dist:conditions>
                    <dist:device-groups>
                        <dist:device-group dist:name="Qualcomm_SM8350"/>
                        <dist:device-group dist:name="Qualcomm_SM8350P"/>
                        <dist:device-group dist:name="Qualcomm_SM8325"/>
                        <dist:device-group dist:name="Qualcomm_SM7325"/>
                        <dist:device-group dist:name="Qualcomm_SM7350"/>
                        <dist:device-group dist:name="Qualcomm_SM7315"/>
                        <dist:device-group dist:name="Qualcomm_SM8450"/>
                        <dist:device-group dist:name="Qualcomm_SM8475"/>
                        <dist:device-group dist:name="Qualcomm_SM7450"/>
                        <dist:device-group dist:name="Qualcomm_SM7475"/>
                        <dist:device-group dist:name="Qualcomm_SM8550"/>
                        <dist:device-group dist:name="Qualcomm_SM8635"/>
                        <dist:device-group dist:name="Qualcomm_SM7675"/>
                        <dist:device-group dist:name="Qualcomm_SM6450"/>
                        <dist:device-group dist:name="Qualcomm_SM8650"/>
                        <dist:device-group dist:name="Qualcomm_SM8750"/>
                        <dist:device-group dist:name="Qualcomm_SM8850"/>
                        <dist:device-group dist:name="Qualcomm_SM8845"/>
                        <dist:device-group dist:name="Qualcomm_SM8735"/>
                        <dist:device-group dist:name="Qualcomm_SM7750"/>
                        <dist:device-group dist:name="Qualcomm_SM7550"/>
                        <dist:device-group dist:name="Qualcomm_SM7635"/>
                        <dist:device-group dist:name="Qualcomm_SM7435"/>
                        <dist:device-group dist:name="Qualcomm_SM6650"/>
                        <dist:device-group dist:name="Qualcomm_SM6475"/>
