<?xml version="1.0" encoding="utf-8"?>
<!-- Test builds only: the adb hooks of src/nonRelease (TestToolsActivity) and the GPU AI diagnosis's process. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name="com.example.thermohammer.TestToolsActivity"
            android:exported="true"
            android:label="ThermoHammer Bench test tools"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true" />
        <!-- the GPU AI diagnosis (adb-started through the activity above), in a process of its own -->
        <service
            android:name="com.example.thermohammer.engine.ai.AiGpuDiagnosisService"
            android:exported="false"
            android:process=":aidiag" />
    </application>
</manifest>
