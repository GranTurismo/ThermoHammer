#version 460
// scene × fog transmittance + fog in-scatter
layout(local_size_x = 8, local_size_y = 8) in;
#include "post.glsl"
layout(set = 1, binding = 2, rgba16f) uniform writeonly image2D dst;
void main() {
    ivec2 id = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(dst);
    if (id.x >= size.x || id.y >= size.y) return;
    vec2 uv = (vec2(id) + 0.5) / vec2(size);
    vec4 f = textureLod(srcB, uv, 0.0);
    imageStore(dst, id, vec4(textureLod(srcA, uv, 0.0).rgb * f.a + f.rgb, 1.0));
}
